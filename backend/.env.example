# Copy to backend/.env for local development (backend/.env is git-ignored).
# On the Claude Code cloud VM, `bash scripts/claude_cloud_postgres.sh` generates a working
# backend/.env with random values. Never commit real secrets.
DJANGO_ENV=development            # development | production
DJANGO_DEBUG=true                 # must be false in production
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080   # local web-app testing only; empty = CORS off
# DJANGO_NUM_PROXIES=1            # number of reverse proxies in front of the app (see throttling)
# DJANGO_EXPOSE_SCHEMA=false      # serve /api/v1/schema/ outside DEBUG
# DJANGO_ADMIN_PATH=admin/

POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Password-recovery emails (D16): any SMTP service. Console backend is used when DEBUG is true.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.test
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=ERP System <no-reply@example.test>

# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=14

# Where uploaded files (receipt photos, scans) are kept. They are served only by the API after a
# permission check, never by static or media URLs. Use a persistent folder outside the code tree
# (a Docker volume in production), back it up with the database, and keep it out of any web
# server's document root. Default: backend/private_files (git-ignored).
# PRIVATE_FILES_ROOT=/var/lib/erp/private_files
