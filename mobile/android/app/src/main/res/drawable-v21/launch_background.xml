<?xml version="1.0" encoding="utf-8"?>
<!-- The native splash shown while the process starts, before Flutter draws its first frame: the
     app's own canvas colour (AppColors.canvas) and brand mark, so there is no white or black
     flash before the real UI appears. The app has no dark theme (see lib/main.dart), so this is
     used for both values/ and values-night/. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item android:width="120dp" android:height="120dp" android:gravity="center">
        <bitmap android:src="@drawable/launch_logo" />
    </item>
</layer-list>
