# Copy to infra/.env (git-ignored) and fill in. Use long random values; never commit them.
# scripts/deploy/bootstrap_vm.sh writes this file for you with random secrets.
DJANGO_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
# The name people use to reach the server (the same as SITE_ADDRESS below, without https://).
DJANGO_ALLOWED_HOSTS=shop.example.com
DJANGO_NUM_PROXIES=1
# Raise once HTTPS is verified end to end:
DJANGO_HSTS_SECONDS=0

# How the server is reached (see infra/Caddyfile): a domain name for automatic HTTPS, or :80 for plain http.
SITE_ADDRESS=shop.example.com
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_USER=erp
POSTGRES_PASSWORD=
POSTGRES_DB=erp

# Password-recovery email (D16): any SMTP service. Empty = recovery emails are not sent.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=ERP System <no-reply@example.test>
