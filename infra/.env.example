# Copy to infra/.env (git-ignored) and fill in. Use long random values; never commit them.
DJANGO_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=api.example.test
DJANGO_NUM_PROXIES=1
# Raise once HTTPS is verified end to end:
DJANGO_HSTS_SECONDS=0

POSTGRES_USER=erp
POSTGRES_PASSWORD=
POSTGRES_DB=erp

# Password-recovery email (D16): any SMTP service.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=ERP System <no-reply@example.test>
